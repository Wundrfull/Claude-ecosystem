#!/usr/bin/env bash
set -e

PORT="${1:-8000}"
cd "$(dirname "$0")"

if lsof -ti:"$PORT" >/dev/null 2>&1; then
  echo "Port $PORT is already in use (PID $(lsof -ti:"$PORT"))."
  echo "  Kill it with: kill \$(lsof -ti:$PORT)"
  echo "  Or pass a different port: ./rundeck 8080"
  exit 1
fi

# Cache-bust on every launch so Chrome always picks up the latest slides/CSS.
BUST="$(date +%s)"
URL="http://localhost:$PORT/?v=$BUST"

echo ""
echo "  Claude Code Team Primer - slide deck (30-min version)"
echo "  ------------------------------------------------------"
echo "  Opening in Chrome: $URL"
echo "  Stop server:       Ctrl-C"
echo ""

# --disable-application-cache forces a fresh fetch even if Chrome cached the
# previous session. --new-window keeps the dev deck separate from normal tabs.
(sleep 1 && open -na "Google Chrome" --args \
  --new-window \
  --disable-application-cache \
  --disk-cache-size=1 \
  "$URL") &

# Serve with no-cache headers. Also accepts POST /notes from deck.js so the
# current slide's speaker notes stream to this terminal as the presenter
# navigates. Keeps the presenter's eyes on one place: slides in Chrome,
# notes in the shell.
exec python3 -c "
import http.server, socketserver, sys, json, re, textwrap, shutil
PORT = int(sys.argv[1])
TAG = re.compile(r'<[^>]+>')
WS  = re.compile(r'[ \t]+')
ENTITIES = [
    ('&amp;', '&'), ('&lt;', '<'), ('&gt;', '>'),
    ('&mdash;', '---'), ('&ndash;', '--'), ('&rarr;', '->'), ('&larr;', '<-'),
    ('&ldquo;', '\"'), ('&rdquo;', '\"'),
    ('&lsquo;', \"'\"), ('&rsquo;', \"'\"),
    ('&nbsp;', ' '), ('&middot;', '-'), ('&hellip;', '...'),
    ('&check;', 'v'), ('&Delta;', 'delta'),
]

def html_to_bullets(html):
    '''Walk the notes HTML once, emit a list of (depth, text) tuples.
    Each <li> becomes one bullet at its nesting depth. Non-list prose
    appears at depth -1 (no marker).'''
    if not html:
        return [(-1, '(no speaker notes for this slide)')]
    # Track which tokens are list/item opens so we know depth.
    # Three branches: known structural tag | any other tag (ignored) | text.
    token_re = re.compile(r'<(/?)(ul|ol|li|p|br)\b[^>]*>|<[^>]+>|([^<]+)', re.IGNORECASE)
    lines = []
    current = []  # accumulates text for the current bullet
    depth = 0     # nesting depth of current <li>; >=0 means inside an <li>
    list_stack = []  # stack of list types opened

    def flush(d):
        if not current:
            return
        text = ''.join(current).strip()
        if text:
            lines.append((d, text))
        current.clear()

    for m in token_re.finditer(html):
        slash, tag, text = m.group(1), (m.group(2) or '').lower(), m.group(3)
        if text is not None:
            current.append(text)
            continue
        if not tag:
            # Unknown tag (<strong>, <code>, <em>, <span>, etc.) — skip it.
            continue
        if tag == 'p':
            if slash:
                flush(-1)
                lines.append((-2, ''))  # blank separator between paragraphs
            else:
                flush(depth if list_stack else -1)
        elif tag == 'br':
            flush(depth if list_stack else -1)
        elif tag in ('ul', 'ol'):
            if slash:
                flush(depth)
                if list_stack:
                    list_stack.pop()
                depth = max(0, depth - 1)
            else:
                flush(depth if list_stack else -1)
                list_stack.append(tag)
                # depth stays; it's bumped when <li> opens
        elif tag == 'li':
            if slash:
                flush(depth)
            else:
                flush(depth)
                depth = len(list_stack)
    flush(depth if list_stack else -1)

    # Expand inline tags + entities, strip any tags we didn't handle.
    out = []
    for d, raw in lines:
        if d == -2:
            out.append((-2, ''))
            continue
        txt = TAG.sub('', raw)
        for e, r in ENTITIES:
            txt = txt.replace(e, r)
        txt = WS.sub(' ', txt).strip()
        if txt or d == -2:
            out.append((d, txt))
    return out

BOLD = '\033[1m'
DIM  = '\033[2m'
CYAN = '\033[36m'
YEL  = '\033[33m'
RST  = '\033[0m'

class Handler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *a, **kw):
        pass  # silence GET access log; notes are the only output we want

    def end_headers(self):
        self.send_header('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0')
        self.send_header('Pragma', 'no-cache')
        self.send_header('Expires', '0')
        super().end_headers()

    def do_POST(self):
        if self.path.split('?')[0] != '/notes':
            self.send_response(404); self.end_headers(); return
        try:
            length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(length) if length else b'{}'
            data = json.loads(body.decode('utf-8'))
        except Exception as e:
            self.send_response(400); self.end_headers(); return
        idx = data.get('index', 0) + 1
        total = data.get('total', 0)
        section = data.get('section', '')
        bullets = html_to_bullets(data.get('notes', ''))
        width = shutil.get_terminal_size((100, 20)).columns
        wrap_width = min(width, 96)
        bar = '-' * min(width, 80)
        hdr = f'{BOLD}{CYAN}slide {idx} / {total}{RST}  {YEL}{section}{RST}'
        sys.stdout.write(f'\n{bar}\n{hdr}\n{bar}\n')
        for depth, text in bullets:
            if depth == -2:
                sys.stdout.write('\n')
                continue
            if depth < 0:
                # plain prose paragraph — wrap cleanly.
                for line in textwrap.wrap(text, width=wrap_width) or ['']:
                    sys.stdout.write(line + '\n')
                continue
            # Bulleted line. depth 1 = top-level, deeper = nested.
            indent_cols = max(0, depth - 1) * 4
            marker = '-' if depth <= 1 else ('*' if depth == 2 else 'o')
            prefix = f'{\" \" * indent_cols}{marker} '
            cont_indent = ' ' * len(prefix)
            for line in textwrap.wrap(
                text,
                width=wrap_width,
                initial_indent=prefix,
                subsequent_indent=cont_indent,
            ) or [prefix]:
                sys.stdout.write(line + '\n')
        sys.stdout.write('\n')
        sys.stdout.flush()
        self.send_response(204); self.end_headers()

with socketserver.TCPServer(('', PORT), Handler) as httpd:
    print(f'Serving with no-cache headers on port {PORT}. Speaker notes will stream here as you navigate.')
    httpd.serve_forever()
" "$PORT"
